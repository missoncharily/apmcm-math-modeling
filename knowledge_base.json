  "paper_structure_checklist": [
    "摘要（包含问题、方法、结论、关键词）",
    "问题重述",
    "问题分析（问题分类、影响因素、难点）",
    "模型假设（合理且有依据）",
    "符号说明表",
    "模型建立（理论基础、数学公式、框图）",
    "模型求解（算法、步骤、代码）",
    "结果分析（可视化、解释、敏感性分析）",
    "模型检验（合理性、稳定性）",
    "模型评价与推广",
    "参考文献",
    "附录（代码、详细数据）"
  ],
  "writing_tips": [
    "摘要要简洁有力，突出创新点",
    "问题分析要深入，不要简单重复题目",
    "模型假设要合理，不能过度简化",
    "公式要规范，使用LaTeX编号",
    "图表要清晰，坐标轴标注完整",
    "代码要规范，添加注释",
    "结果分析要详细，不能只给数字",
    "敏感性分析体现模型稳定性",
    "语言要规范，避免口语化",
    "全文逻辑要连贯，前后呼应"
  ],
  "common_mistakes": [
    "问题分析过于简单，未挖掘深层关系",
    "模型假设不合理或未说明依据",
    "缺少模型框图或流程图",
    "公式推导跳步骤，难以理解",
    "结果只有数字，缺少分析解释",
    "图表质量差，坐标轴无标注",
    "未进行敏感性分析或模型检验",
    "代码凌乱，无注释",
    "参考文献格式不规范",
    "排版混乱，字体大小不一"
  ]
}
