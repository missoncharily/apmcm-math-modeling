      "methods": [
        {
          "name": "线性规划",
          "applicable": "目标函数和约束均为线性",
          "tools": ["scipy.optimize.linprog", "PuLP", "Gurobi"]
        },
        {
          "name": "非线性规划",
          "applicable": "目标函数或约束包含非线性",
          "tools": ["scipy.optimize.minimize", "CVXPY"]
        },
        {
          "name": "整数规划",
          "applicable": "变量要求为整数",
          "tools": ["PuLP", "Google OR-Tools"]
        },
        {
          "name": "遗传算法",
          "applicable": "复杂非凸优化，NP难问题",
          "tools": ["DEAP", "PyGAD"]
        }
      ]
    },
